{
  "builders": [
    {
      "type": "proxmox-iso",
      "proxmox_url": "{{user `proxmox_url`}}",
      "username": "{{user `proxmox_username`}}",
      "password": "{{user `proxmox_password`}}",
      "node": "{{user `proxmox_node`}}",
      "insecure_skip_tls_verify": true,
      "vm_name": "{{user `vm_name`}}",
      "vm_id": "{{user `proxmox_vm_id`}}",
      "memory": "{{user `memory`}}",
      "cores": 2,
      "sockets": 1,
      "cpu_type": "host",
      "os": "win11",
      "iso_file": "{{user `proxmox_iso_file`}}",
      "iso_storage_pool": "{{user `proxmox_iso_storage_pool`}}",
      "unmount_iso": true,
      "additional_iso_files": [
        {
          "device": "ide3",
          "iso_storage_pool": "{{user `proxmox_iso_storage_pool`}}",
          "unmount": true,
          "iso_file": "{{user `proxmox_virtio_iso_file`}}"
        },
        {
          "device": "sata0",
          "iso_storage_pool": "{{user `proxmox_iso_storage_pool`}}",
          "unmount": true,
          "cd_files": [
            "{{user `autounattend`}}",
            "./floppy/WindowsPowershell.lnk",
            "./floppy/PinTo10.exe",
            "./scripts/fixnetwork.ps1",
            "./scripts/disable-screensaver.ps1",
            "./scripts/disable-winrm.ps1",
            "./scripts/enable-winrm.ps1",
            "./scripts/microsoft-updates.bat",
            "./scripts/win-updates.ps1"
          ],
          "cd_label": "PROVISION"
        }
      ],
      "network_adapters": [
        {
          "bridge": "{{user `proxmox_network_bridge`}}",
          "model": "virtio",
          "firewall": false
        }
      ],
      "disks": [
        {
          "type": "virtio",
          "disk_size": "{{user `disk_size`}}M",
          "storage_pool": "{{user `proxmox_storage_pool`}}",
          "storage_pool_type": "{{user `proxmox_storage_pool_type`}}",
          "format": "raw",
          "cache_mode": "writeback",
          "io_thread": true
        }
      ],
      "scsi_controller": "virtio-scsi-single",
      "qemu_agent": true,
      "cloud_init": false,
      "boot_wait": "6m",
      "boot_command": [
        "<enter>"
      ],
      "communicator": "winrm",
      "winrm_username": "vagrant",
      "winrm_password": "vagrant",
      "winrm_timeout": "{{user `winrm_timeout`}}",
      "winrm_use_ssl": false,
      "winrm_insecure": true,
      "shutdown_command": "shutdown /s /t 10 /f /d p:4:1 /c \"Packer Shutdown\"",
      "shutdown_timeout": "15m",
      "template_name": "{{user `template_name`}}",
      "template_description": "Windows 10 - Built by Packer on {{isotime \"2006-01-02\"}}"
    }
  ],
  "post-processors": [
    {
      "keep_input_artifact": false,
      "output": "windows_10_{{.Provider}}.box",
      "type": "vagrant",
      "vagrantfile_template": "vagrantfile-windows_10.template"
    }
  ],
  "provisioners": [
    {
      "execute_command": "{{ .Vars }} cmd /c \"{{ .Path }}\"",
      "remote_path": "/tmp/script.bat",
      "scripts": [
        "./scripts/enable-rdp.bat"
      ],
      "type": "windows-shell"
    },
    {
      "scripts": [
        "./scripts/vm-guest-tools.ps1",
        "./scripts/debloat-windows.ps1"
      ],
      "type": "powershell"
    },
    {
      "restart_timeout": "{{user `restart_timeout`}}",
      "type": "windows-restart"
    },
    {
      "scripts": [
        "./scripts/set-powerplan.ps1",
        "./scripts/docker/disable-windows-defender.ps1"
      ],
      "type": "powershell"
    },
    {
      "execute_command": "{{ .Vars }} cmd /c \"{{ .Path }}\"",
      "remote_path": "/tmp/script.bat",
      "scripts": [
        "./scripts/pin-powershell.bat",
        "./scripts/compile-dotnet-assemblies.bat",
        "./scripts/set-winrm-automatic.bat",
        "./scripts/uac-enable.bat",
        "./scripts/dis-updates.bat",
        "./scripts/compact.bat"
      ],
      "type": "windows-shell"
    }
  ],
  "variables": {
    "autounattend": "./answer_files/10/Autounattend.xml",
    "disk_size": "61440",
    "disk_type_id": "1",
    "memory": "2048",
    "headless": "false",
    "iso_checksum": "sha256:ef7312733a9f5d7d51cfa04ac497671995674ca5e1058d5164d6028f0938d668",
    "iso_url": "https://software-static.download.prss.microsoft.com/dbazure/988969d5-f34g-4e03-ac9d-1f9786c66750/19045.2006.220908-0225.22h2_release_svc_refresh_CLIENTENTERPRISEEVAL_OEMRET_x64FRE_en-us.iso",
    "restart_timeout": "5m",
    "vhv_enable": "false",
    "virtio_win_iso": "~/virtio-win.iso",
    "vm_name": "windows_10",
    "winrm_timeout": "6h",
    "vmx_version": "14",
    "proxmox_url": "https://proxmox.example.com:8006/api2/json",
    "proxmox_username": "root@pam",
    "proxmox_password": "your_proxmox_password",
    "proxmox_node": "pve",
    "proxmox_vm_id": "9020",
    "proxmox_iso_file": "local:iso/Win10_22H2_English_x64.iso",
    "proxmox_iso_storage_pool": "local",
    "proxmox_virtio_iso_file": "local:iso/virtio-win.iso",
    "proxmox_storage_pool": "local-lvm",
    "proxmox_storage_pool_type": "lvm",
    "proxmox_network_bridge": "vmbr0",
    "template_name": "windows-10"
  }
}